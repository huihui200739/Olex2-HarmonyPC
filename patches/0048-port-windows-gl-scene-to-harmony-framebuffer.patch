+#if defined(OLEX2_NATIVE_WIDGETS) && !defined(__WIN32__) && !defined(__WXWIDGETS__)
+#include "wglscene.h"
+#include <stdexcept>
+
+TWGlScene::~TWGlScene() noexcept {try {Destroy();} catch(...) {}}
+void TWGlScene::InitialiseSurface(const Olex2LegacyHost& host,int width,int height) {
+  if(IsBound()||framebuffer_.IsOpen())throw std::logic_error("The offscreen scene is already initialised");
+  Bind(host);
+  try {
+    if(!TwxGlScene::MakeCurrent())throw std::runtime_error("The offscreen scene requires a current renderer lease");
+    framebuffer_.CreateFromCurrent(width,height);
+  }
+  catch(...) {Unbind();throw;}
+}
+bool TWGlScene::MakeCurrent() {
+  if(!IsBound()||!TwxGlScene::MakeCurrent())return false;
+  return framebuffer_.MakeCurrent();
+}
+void TWGlScene::Destroy() {
+  if(!framebuffer_.IsOpen()){Unbind();return;}
+  if(!TwxGlScene::MakeCurrent())throw std::runtime_error("The offscreen scene must be destroyed with its borrowed context current");
+  ReleaseFontResources();framebuffer_.Close();Unbind();
+}
+std::vector<uint8_t> TWGlScene::ReadRGBA() {
+  if(!MakeCurrent())throw std::runtime_error("The offscreen renderer lease is not current");
+  return framebuffer_.ReadRGBA();
+}
