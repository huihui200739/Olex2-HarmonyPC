    "${project_root}/upstream/olex/primtvs.cpp"
    "${project_root}/native/gradient_options.cpp"
    "${project_root}/native/original_display_options.cpp"
    "${project_root}/upstream/olex/ctrls/frameext.cpp"
    "${project_root}/native/frame_platform.cpp"
    "${project_root}/native/native_main_frame.cpp"
    "${project_root}/upstream/olex/updateoptions.cpp"
    "${project_root}/native/original_update_options_store.cpp"
    "${project_root}/native/update_options_persistence.cpp"
    "${project_root}/upstream/olex/ctrls.cpp"
    "${project_root}/upstream/olex/msgbox.cpp"
    "${project_root}/native/native_ui_scheduler.cpp"
    "${project_root}/native/native_dialog.cpp"
    "${project_root}/native/native_dialog_factory.cpp"
    "${project_root}/native/arkui_dialog_backend.cpp"
    "${project_root}/native/original_command_action.cpp"
