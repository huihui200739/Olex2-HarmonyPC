+        try { nativeBridge.redrawOriginalDocument(); } catch (redrawError) { this.originalLog = nativeBridge.getOriginalLogs(); }
+      }
+      this.rebindPresentedSessionAfterModelChange();
+      this.readOriginalDocumentStatus();
+      this.refreshGraphics();
