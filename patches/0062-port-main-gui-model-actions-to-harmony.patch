+namespace olex2::harmony {
+bool DispatchHarmonyMainGuiAction(gxlib::TGXApp& app, const std::string& action) {
+  if (action == "toggle-cell") {
+    app.SetCellVisible(!app.IsCellVisible());
+    TStateRegistry::GetInstance().SetState(app.stateCellVisible, app.IsCellVisible(), EmptyString(), true);
+    return true;
+  }
+  if (action == "toggle-basis") {
+    app.SetBasisVisible(!app.IsBasisVisible());
+    TStateRegistry::GetInstance().SetState(app.stateBasisVisible, app.IsBasisVisible(), EmptyString(), true);
+    return true;
+  }
+  return false;
+}
