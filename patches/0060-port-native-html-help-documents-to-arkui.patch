+std::string THtmlManager::ResolveResource(const std::string& path) const {
+  if(path.empty()||path.front()=='/'||path.front()=='#'||path.find(':')!=std::string::npos||currentPagePath_.empty())return path;
+  const size_t slash=currentPagePath_.find_last_of("/\\");
+  if(slash==std::string::npos)return path;
+  return currentPagePath_.substr(0,slash+1)+path;
+}
+std::vector<uint8_t> THtmlManager::ReadResource(const std::string& path) const {
+  if(!resourceProvider_)return {};
+  auto result=resourceProvider_(ResolveResource(path));
+  if(!result)return {};
+  if(result->size()>32u*1024u*1024u)throw std::length_error("HTML resource exceeds 32 MiB");
+  return std::move(*result);
+}
+void THtmlManager::Configure(THtmlNativeDocument& document) const {
+  if(useResourceProvider_)document.SetImageProvider([this](const std::string& path){return ReadResource(path);});
+  else document.SetImageProvider(imageProvider_);
+  document.SetLinkHandler([this](const THtmlNativeLink& link){DispatchLink(link);});
+}
+void THtmlManager::DispatchLink(const THtmlNativeLink& link) const {
+  if(!linkHandler_)return;
+  THtmlNativeLink resolved=link;
+  resolved.href=ResolveResource(resolved.href);
+  linkHandler_(resolved);
+}
+void THtmlManager::InitialiseMain(olex2::harmony::ui::NodeBackend& backend,
+    olex2::harmony::ui::Widget* parent) {
+  if(destroyed_)throw std::logic_error("HTML manager has been destroyed");
+  if(mainOwner_)return;
+  auto next=std::make_unique<THtml>(*this,backend,parent);
+  main=next.get();mainOwner_=std::move(next);
+}
+void THtmlManager::SetImageProvider(ImageProvider provider) {
+  imageProvider_=std::move(provider);useResourceProvider_=false;
+  if(main&&main->document_)Configure(*main->document_);
+}
+void THtmlManager::SetResourceProvider(ResourceProvider provider) {
+  resourceProvider_=std::move(provider);useResourceProvider_=true;
+  if(main&&main->document_)Configure(*main->document_);
+}
+void THtmlManager::SetLinkHandler(LinkHandler handler) {
+  linkHandler_=std::move(handler);
+  if(main&&main->document_)Configure(*main->document_);
+}
+bool THtmlManager::SetPage(const std::string& html) {
+  if(!main||destroyed_)return false;
+  main->SetPage(html);return true;
+}
+bool THtmlManager::LoadPage(const std::string& path) {
+  if(!main||destroyed_||path.empty()||!resourceProvider_)return false;
+  auto bytes=resourceProvider_(path);
+  if(!bytes)return false;
+  if(bytes->size()>4u*1024u*1024u)throw std::length_error("HTML document exceeds 4 MiB");
