+#if defined(__OHOS__) && !defined(__WXWIDGETS__)
+// TMainForm's wx window/event system is replaced by the native ArkUI host.
+// Keep a small, real compatibility library for the pure form functions that
+// xpprocs.cpp can provide without a desktop window.
+#include "harmony_mainform.h"
+#include "original_xpprocs.h"
+#include <memory>
+
+namespace olex2::harmony {
+esdl::TLibrary* CreateHarmonyMainFormLibrary() {
+  std::unique_ptr<esdl::TLibrary> library(new esdl::TLibrary("form"));
+  RegisterHarmonyXpprocs(*library);
+  return library.release();
+}
+}
