+#if defined(__OHOS__) && !defined(__WXWIDGETS__)
+// The original desktop extension set is registered by TMainForm. Harmony has
+// no wx form, so this translation unit registers the subset whose original
+// behavior is independent of desktop widgets. The remaining commands stay
+// unavailable instead of being replaced with placeholders.
+#include "original_xpprocs.h"
+#include "function.h"
+#include "library.h"
+#include "os_util.h"
+#include "bapp.h"
+#include "gldefs.h"
+#include <cstdlib>
+
+extern char** environ;
+
+namespace {
+void HarmonyFunHasGUI(const TStrObjList&, TMacroData& result) {
+  result.SetRetVal(true);
+}
+void HarmonyFunIsOS(const TStrObjList& params, TMacroData& result) {
+  result.SetRetVal(params[0].Equalsi("ohos") || params[0].Equalsi("harmony"));
+}
+void HarmonyFunStrcat(const TStrObjList& params, TMacroData& result) {
+  result.SetRetVal(params[0] + params[1]);
+}
+void HarmonyFunStrcmp(const TStrObjList& params, TMacroData& result) {
+  result.SetRetVal(params[0] == params[1]);
+}
+void HarmonyFunGetEnv(const TStrObjList& params, TMacroData& result) {
+  if (params.IsEmpty()) {
+    if (environ != nullptr) {
+      for (size_t i = 0; environ[i] != nullptr; ++i)
+        TBasicApp::NewLogEntry() << environ[i];
+    }
+  }
+  else {
+    result.SetRetVal(olx_getenv(params[0]));
+  }
+}
+void HarmonyFunRGB(const TStrObjList& params, TMacroData& result) {
+  if (params.Count() == 3) {
+    result.SetRetVal((uint32_t)OLX_RGB(params[0].ToInt(), params[1].ToInt(),
+      params[2].ToInt()));
+  }
+  else if (params.Count() == 4) {
+    result.SetRetVal((uint32_t)OLX_RGBA(params[0].ToInt(), params[1].ToInt(),
+      params[2].ToInt(), params[3].ToInt()));
+  }
+}
+}
+
+namespace olex2::harmony {
+std::size_t RegisterHarmonyXpprocs(esdl::TLibrary& library) {
+  library.Register(new esdl::TStaticFunction(&HarmonyFunHasGUI, "HasGUI", fpNone,
+    "Returns whether the Harmony application has a graphical interface"));
+  library.Register(new esdl::TStaticFunction(&HarmonyFunIsOS, "IsOS", fpOne,
+    "Returns true for Harmony (ohos or harmony)"));
+  library.Register(new esdl::TStaticFunction(&HarmonyFunStrcat, "Strcat", fpTwo));
+  library.Register(new esdl::TStaticFunction(&HarmonyFunStrcmp, "Strcmp", fpTwo));
+  library.Register(new esdl::TStaticFunction(&HarmonyFunGetEnv, "GetEnv", fpNone | fpOne));
+  library.Register(new esdl::TStaticFunction(&HarmonyFunRGB, "RGB", fpThree | fpFour));
+  return 6;
+}
+}
