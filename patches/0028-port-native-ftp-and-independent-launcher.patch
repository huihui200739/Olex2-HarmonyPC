 void DoRun();
 void DoLaunch(const TStrList &args);
+#ifdef OLEX2_NATIVE_LAUNCHER
+static int NativeExec(const olxstr& executable, const TStrList& arguments) {
+  std::vector<std::string> values;
+  for (size_t i=0; i<arguments.Count(); ++i) {
+    const olxcstr bytes = TUtf8::Encode(arguments[i]);
+    values.emplace_back(bytes.c_str(), bytes.Length());
+  }
+  const olxcstr path = TUtf8::Encode(executable);
+  olex2::harmony::UnirunProcessArguments owned(std::move(values));
+  return olex2::harmony::UnirunReplaceProcess(
+    std::string(path.c_str(), path.Length()), owned);
+}
+#else
 char **ListToArgs(TStrList &args_list) {
   char **args = new char*[args_list.Count()+1];
   args[args_list.Count()] = NULL;
