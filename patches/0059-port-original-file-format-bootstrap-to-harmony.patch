+namespace olex2::harmony {
+std::size_t RegisterOriginalFileFormats(gxlib::TGXApp& app) {
+  // Match the original desktop front-end aliases. Parser instances are shared
+  // for extensions that describe the same upstream file grammar.
+  TCif* cif = new TCif;
+  app.RegisterXFileFormat(cif, "cif");
+  app.RegisterXFileFormat(cif, "cfx_LANA");
+  app.RegisterXFileFormat(cif, "cmf");
+  app.RegisterXFileFormat(cif, "fcf");
+  app.RegisterXFileFormat(cif, "fco");
+  app.RegisterXFileFormat(new TMol, "mol");
+  TIns* ins = new TIns;
+  app.RegisterXFileFormat(ins, "ins");
+  app.RegisterXFileFormat(ins, "res");
+  app.RegisterXFileFormat(new TXyz, "xyz");
+  app.RegisterXFileFormat(new TP4PFile, "p4p");
+  app.RegisterXFileFormat(new TCRSFile, "crs");
+  app.RegisterXFileFormat(new TPdb, "pdb");
+  app.RegisterXFileFormat(new TXDMas, "mas");
+  app.RegisterXFileFormat(new TOXMFile(app), "oxm");
+  app.RegisterXFileFormat(new TMol2, "mol2");
+
+  static const char* const extensions[] = {
+    "cif", "cfx_LANA", "cmf", "fcf", "fco", "mol", "ins", "res",
+    "xyz", "p4p", "crs", "pdb", "mas", "oxm", "mol2"
+  };
+  for (const char* extension : extensions) {
+    if (app.XFile().FindFormat(olxstr(extension)) == nullptr) {
+      throw std::runtime_error("Original application file format registration failed");
+    }
+  }
+  return sizeof(extensions) / sizeof(extensions[0]);
+}
+}
