    message(FATAL_ERROR "Native original widgets require the real source runtime")
  endif()
  target_sources(${target} PRIVATE
    "${project_root}/upstream/gxlib/wglscene.cpp"
    "${project_root}/native/gles_offscreen_target.cpp"
    "${project_root}/upstream/gxlib/wxglscene.cpp"
    "${project_root}/upstream/olex/dgenopt.cpp"
    "${project_root}/upstream/olex/ptable.cpp"
    "${project_root}/upstream/olex/nui/nui.cpp"
    "${project_root}/upstream/olex/nui/skeleton.cpp"
    "${project_root}/upstream/olex/xglcanv.cpp"
    "${project_root}/upstream/olex/html/imgcellext.cpp"
    "${project_root}/upstream/olex/xglapp.cpp"
    "${project_root}/upstream/olex/tasks.cpp"
    "${project_root}/upstream/olex/edit.cpp"
    "${project_root}/upstream/olex/updateth.cpp"
    "${project_root}/upstream/olex/scenep.cpp"
    "${project_root}/upstream/olex/matprop.cpp"
    "${project_root}/native/generation_options.cpp"
