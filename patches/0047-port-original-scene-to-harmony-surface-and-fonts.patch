+#if defined(OLEX2_NATIVE_WIDGETS) && !defined(__WXWIDGETS__)
+#include "wxglscene.h"
+#include "eutf8.h"
+#include <cmath>
+#include <stdexcept>
+
+TwxGlScene::TwxGlScene(const olxstr& fontsFolder) {
+  auto utf8=TUtf8::Encode(fontsFolder);
+  fontsFolder_.assign(utf8.c_str(),utf8.Length());
+  if(fontsFolder_.find('\0')!=std::string::npos)
+    throw std::invalid_argument("Font folder contains an embedded NUL");
+  if(!fontsFolder_.empty()&&fontsFolder_.back()!='/')fontsFolder_+='/';
+}
+TwxGlScene::~TwxGlScene()=default;
+void TwxGlScene::Bind(const Olex2LegacyHost& host) {
+  if(bound_||IsEnabled())throw std::logic_error("The original scene already has a surface lease");
+  if(!host.make_current||!host.framebuffer_size||!host.resolve)
+    throw std::invalid_argument("Incomplete original scene surface lease");
+  // A display transition may only replace metrics after the old-context lists
+  // have been retired. The factory keeps same-display glyphs between leases.
+  fonts_.SetDisplayMetrics(host.font_display_metrics);
+  host_=host;bound_=true;SetEnabled(true);
+}
+void TwxGlScene::Unbind() noexcept {
+  SetEnabled(false);bound_=false;host_=Olex2LegacyHost{};
+}
+bool TwxGlScene::MakeCurrent() {
+  return IsEnabled()&&bound_&&host_.make_current&&host_.make_current()!=0;
+}
+void TwxGlScene::RequireCurrent() const {
+  if(!bound_||!IsEnabled()||!host_.make_current||!host_.make_current())
+    throw std::runtime_error("No current leased context for original scene fonts");
+}
+TGlFont& TwxGlScene::DoCreateFont(TGlFont& font,bool half) const {
+  RequireCurrent();
+  return fonts_.Create(font,half,fontScale_,fontsFolder_);
+}
+void TwxGlScene::ReleaseFontResources() {
+  RequireCurrent();
+  fonts_.Release();
+}
+void TwxGlScene::ScaleFonts(double scale) {
+  if(!std::isfinite(scale)||scale<=0||scale>8||scaling_)
+    throw std::invalid_argument("Unbalanced or invalid original scene font scale");
+  RequireCurrent();
+  // Release both regular and small display lists. Recreate lazily through the
+  // genuine scene, keeping persisted IDs, exact families and @ vector sizes.
+  fonts_.Release();fontScale_=scale;scaling_=true;
+}
+void TwxGlScene::RestoreFontScale() {
+  if(!scaling_)return;
+  RequireCurrent();
+  fonts_.Release();fontScale_=1;scaling_=false;
+}
+olxstr TwxGlScene::ShowFontDialog(TGlFont*,const olxstr&) {
+  // The previous platform scene had this same explicit limitation. ArkUI
+  // selection must be asynchronous; no fake cancellation or nested UI loop.
+  throw std::runtime_error("The original scene needs an asynchronous native font chooser");
+}
